target/
**/target/
# cargo-zigbuild drops this in the working directory during a cross build
.intentionally-empty-file.o
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/

# ---- ESMFold ----------------------------------------------------------------
# Large regenerable parity fixtures + model weights (see esmfold/python/).
esmfold/fixtures/lm
esmfold/fixtures/trunk
esmfold/fixtures/bench
esmfold/.esmfold/

# ---- ProteinMPNN ------------------------------------------------------------
# Benchmark scratch (per-run FASTAs, log-prob dumps).
proteinmpnn/results/_runs/
proteinmpnn/results/_bench.log

# ---- RFdiffusion2 -----------------------------------------------------------
# Fixtures are regenerated by rfdiffusion2/python/gen_*.py; the weight fixture
# alone is 332 MB. Reference/port run artefacts likewise.
rfdiffusion2/fixtures/**/*.safetensors
rfdiffusion2/runs/
rfdiffusion2/outputs/
rfdiffusion2/bench/runs/
rfdiffusion2/bench/ligand_runs/

# ---- checkpoints ------------------------------------------------------------
# Model checkpoints are excluded by default...
*.pt
*.bin
# ...except the four vanilla ProteinMPNN ones, which are embedded into the
# executable at build time and so must be present for `cargo build` to work.
!proteinmpnn/weights/*.pt

# Safetensors are excluded by default; the few that are embedded at build time
# (and so are required to compile) are re-included explicitly.
*.safetensors
!esmfold/fixtures/constants/residue_constants.safetensors
!esmfold/esmfold1/fixtures/constants/residue_constants.safetensors
!proteinmpnn/fixtures/**/*.safetensors
!rfdiffusion2/rfd2/data/*.safetensors
!gui/data/*.safetensors
!gui/data/ligand/*.safetensors

# Optional upstream reference clones, for the parity tests (never committed)
/ref_ProteinMPNN/
/ref_RFdiffusion2/
